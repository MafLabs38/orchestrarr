      "update": { "promote": ["patch"] }
    },
    {
      "id": "repository:example/recipes",
      "kind": "own",
      "source": "example/recipes",
      "qualify": { "mode": "health" },
      "promote": { "rollback": "previous-tag" },
      "update": { "promote": ["patch", "minor"] }
    },
    {
      "id": "repository:example/billing-api",
      "kind": "own",
      "source": "example/billing-api",
      "qualify": { "mode": "smoke" }
