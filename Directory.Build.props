<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: XML comments are not required on every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <Authors>Orchestrarr contributors</Authors>
    <Product>Orchestrarr</Product>
  </PropertyGroup>
  <!-- The same rules as SonarLint in the editor and the SonarQube server: a finding that the editor would underline fails the build here. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
