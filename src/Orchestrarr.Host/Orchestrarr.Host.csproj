<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Orchestrarr</AssemblyName>
    <RootNamespace>Orchestrarr.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orchestrarr.Providers.GitHub\Orchestrarr.Providers.GitHub.csproj" />
    <ProjectReference Include="..\Orchestrarr.Providers.Portarr\Orchestrarr.Providers.Portarr.csproj" />
    <ProjectReference Include="..\Orchestrarr.Storage\Orchestrarr.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- The sandbox's settings (a fixed operator, a grant on every repository) never travel in the image. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orchestrarr.Host.Test" />
  </ItemGroup>
</Project>
